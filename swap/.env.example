# Copier ce fichier en ".env.local" (jamais commité) puis renseigner les valeurs.
# Seules les variables préfixées EXPO_PUBLIC_ sont lisibles par l'app :
# elles sont PUBLIQUES (embarquées dans l'app). N'y mettez jamais de clé secrète
# (service_role Supabase, clé secrète Stripe, etc.) : celles-ci vivent côté serveur uniquement.

# URL du projet Supabase (Settings > API)
EXPO_PUBLIC_SUPABASE_URL=
# Clé publique "anon" / "publishable" Supabase (protégée par les règles RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# "demo" affiche des annonces FICTIVES clairement signalées (développement uniquement).
# "live" lit les vraies annonces dans Supabase. Par défaut : live si Supabase est configuré, sinon demo.
EXPO_PUBLIC_DATA_MODE=
